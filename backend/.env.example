NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/revenuepilot
FRONTEND_URL=http://localhost:5173
AI_PROVIDER=local
AI_API_KEY=
AI_MODEL=local-rules-v1
AI_STRUCTURED_MODEL=
# Optional external AI examples:
# AI_PROVIDER=openai
# AI_MODEL=gpt-4.1-mini
# AI_PROVIDER=gemini
# AI_MODEL=gemini-3.6-flash
# AI_STRUCTURED_MODEL=gemini-3.5-flash-lite
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret

# Buildathon-safe merchant/admin protection.
# Required to call sensitive merchant mutation routes (e.g. PATCH /api/policies).
# Requests must send this value in the "x-merchant-key" header.
# This is NOT a production auth system — see backend/src/middleware/merchantAuth.middleware.ts.
# Never expose this value to the customer-facing frontend bundle.
MERCHANT_ADMIN_KEY=
